# -----------------------------------------------------------------------------
# MedAssist AI - AI Service Environment Configuration Example
# Copy this file to '.env' and fill in the required API keys.
# -----------------------------------------------------------------------------

# --- LLM API Keys ---
# Set your API keys to enable live LLM models. At least one provider is recommended.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here

# --- Model Overrides (Optional) ---
# Specify which model to use for each provider. If not set, the service uses default fallbacks.
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant
ZHIPU_MODEL=glm-4-flash

# --- Server Port (Optional) ---
# Default port for FastAPI is 8000. Change this if port 8000 is occupied.
PORT=8000
