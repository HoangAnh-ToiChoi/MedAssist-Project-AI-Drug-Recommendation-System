{
  "info": {
    "name": "MedAssist CHCKNSPC-80 - Allergy & Fallback Tests",
    "description": "Postman Collection dùng để test chức năng kiểm tra triệu chứng, bộ lọc dị ứng, cảnh báo nguy kịch và cơ chế dự phòng DB Fallback của dự án MedAssist.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Đăng nhập lấy Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Đăng nhập thành công', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set('accessToken', json.data.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Gợi ý thuốc bình thường (Happy Path)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symptoms\": [\"sốt\", \"đau đầu\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/symptoms/check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "symptoms",
            "check"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Đầu ra trả về gợi ý thuốc hợp lệ', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.recommendations).to.be.an('array');",
              "  pm.expect(json.data.recommendations.length).to.be.at.most(5);",
              "});",
              "",
              "pm.test('Chế độ fallback DB hoạt động chuẩn xác', function () {",
              "  pm.expect(json.data.engineVersion).to.eql('db-fallback-v1');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Triệu chứng nguy kịch (Khó thở)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symptoms\": [\"khó thở\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/symptoms/check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "symptoms",
            "check"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Có cảnh báo nguy kịch tương ứng', function () {",
              "  pm.expect(json.data.dangerAlert).to.be.a('string').and.include('Khó thở có thể là dấu hiệu');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Gửi danh sách triệu chứng trống (Lỗi 400)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symptoms\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/symptoms/check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "symptoms",
            "check"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400 Bad Request', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Báo lỗi validation chính xác', function () {",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(json.message).to.eql('Vui lòng chọn ít nhất một triệu chứng');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Không có Access Token (Lỗi 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symptoms\": [\"sốt\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/symptoms/check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "symptoms",
            "check"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401 Unauthorized', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Báo lỗi xác thực', function () {",
              "  pm.expect(json.success).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
