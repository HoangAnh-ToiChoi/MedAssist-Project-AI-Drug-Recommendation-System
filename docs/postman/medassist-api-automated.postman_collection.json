{
  "info": {
    "name": "MedAssist API - Automated Smoke Tests",
    "description": "Postman collection chạy smoke test tự động cho auth login, patient history CRUD và symptoms AI recommendation. Trước khi chạy, sửa collection variables: baseUrl, email, password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "historyId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Health status is ok', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login And Store Tokens",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Login success', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.refreshToken).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.data.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Create Patient History",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"condition\": \"Đau dạ dày\",\n  \"status\": \"chronic\",\n  \"diagnosedAt\": \"2024-01-15\",\n  \"notes\": \"Created by Postman automated smoke test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/history",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "history"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('History created', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.id).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.condition).to.eql('Đau dạ dày');",
              "});",
              "",
              "pm.collectionVariables.set('historyId', json.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Get Patient History",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/history",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "history"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('History list contains created record', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.be.an('array');",
              "  pm.expect(json.data.some((item) => item.id === pm.collectionVariables.get('historyId'))).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Update Patient History",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"active\",\n  \"notes\": \"Updated by Postman automated smoke test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/history/{{historyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "history",
            "{{historyId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('History updated', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.id).to.eql(pm.collectionVariables.get('historyId'));",
              "  pm.expect(json.data.status).to.eql('active');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Symptoms AI Recommendation",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symptoms\": [\"sốt\", \"đau đầu\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/symptoms/check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "symptoms",
            "check"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Recommendation response is valid', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.id).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.recommendations).to.be.an('array');",
              "  pm.expect(json.data.recommendations.length).to.be.at.most(5);",
              "  json.data.recommendations.forEach((item) => {",
              "    pm.expect(Number(item.confidence || 0)).to.be.above(0);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Delete Patient History",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/history/{{historyId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "history",
            "{{historyId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('History deleted', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Confirm History Deleted",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/history",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "history"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Deleted record is absent', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.some((item) => item.id === pm.collectionVariables.get('historyId'))).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
